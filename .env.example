# Conexão com o banco PostgreSQL (Produção / Supabase / Neon / Local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_banco?schema=public"

# Secret para JWT / NextAuth (Gere uma chave randômica forte em produção)
NEXTAUTH_SECRET="sua-chave-secreta-randomica-min-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# Provedor de E-mail (Resend)
RESEND_API_KEY="sua_resend_api_key_aqui"

# Webhook do Discord para Notificações Operacionais
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN"
